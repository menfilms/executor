<!-- ============================================================
     СЮДА: Spectre/MainWindow.xaml  (заменить файл целиком)
     Окно без системной рамки, фиксированный размер (NoResize),
     WebView2 растянут на всё окно. Тайтлбар, кнопки свернуть/
     закрыть и перетаскивание рисует сам index.html.
     ============================================================ -->
<Window x:Class="Spectre.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SPECTRE" Width="1080" Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0b0e15">

    <!-- WebView2 на весь Grid: без полей, без других элементов -->
    <Grid>
        <!-- DefaultBackgroundColor = цвет --bg из index.html,
             чтобы не было белой вспышки при загрузке -->
        <wv2:WebView2 x:Name="webView" DefaultBackgroundColor="#0b0e15"/>
    </Grid>

</Window>
